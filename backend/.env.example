# Stride backend environment configuration.
# Copy to .env and adjust for your environment.

# General
ENVIRONMENT=development
DEBUG=true

# Database (async driver). Postgres in production, SQLite for quick local runs.
DATABASE_URL=postgresql+asyncpg://stride:stride@localhost:5432/stride
# DATABASE_URL=sqlite+aiosqlite:///./stride_dev.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Set true when connecting through PgBouncer in transaction pooling mode.
DB_DISABLE_PREPARED_CACHE=false

# Safety ceiling for how many tasks a single board/timeline view aggregates.
MAX_VIEW_TASKS=2000

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_USE_FAKE_IF_UNAVAILABLE=true

# Security — CHANGE THIS in production (min 32 chars).
JWT_SECRET_KEY=change-me-in-production-min-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS — comma-separated origins, or "*" for all (credentials auto-disabled with "*").
BACKEND_CORS_ORIGINS=http://localhost:5173

# S3 / object storage (MinIO locally)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=stride-storage
S3_REGION=us-east-1

# 5-Gate AI pipeline LLM providers (all optional).
# Set any that you have a free key for; they are tried in LLM_PROVIDER_ORDER and the
# pipeline falls back to deterministic heuristics if every provider fails or is unset.
# NOTE: free tiers may train on your prompts — don't send sensitive data in production.
LLM_ENABLED=true
LLM_PROVIDER_ORDER=openrouter,groq,gemini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash

# Integrations
GITHUB_WEBHOOK_SECRET=stride-github-webhook-secret
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# FIGMA_API_ACCESS_TOKEN=
